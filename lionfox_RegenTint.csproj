<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Vintage Story 1.22 runs on .NET 10; mod assemblies must match. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>$(ModAssembly)</AssemblyName>
    <RootNamespace>lionfox_RegenTint</RootNamespace>
    <!-- Keep this in step with modinfo.json's "version". PackageMod names the
         zip from it, and two different builds sharing one version string is the
         trap that produced two distinct torchesheat_2.0.0.zip files on
         2026-09-09 - the filename cannot tell them apart. -->
    <Version>0.1.0</Version>
    <!-- The repo root IS the loadable mod folder: modinfo.json and the built
         DLL sit side by side, and both are tracked. Do not "tidy" this into
         bin/ without also fixing what git tracks. -->
    <OutputPath>../lionfox_RegenTint</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- tests/ is its own project; keep its sources out of the mod. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- ── Vintage Story install directory ──────────────────────────────────
       Resolution order: -p:VS_PATH=... , then the VINTAGE_STORY environment
       variable Vintage Story itself sets, then the usual install locations.
       The install has already moved once (D:\ on SylG5, H:\ on SylDesk), so a
       hardcoded default is a machine fact and must never be the only path. -->
  <PropertyGroup>
    <VS_PATH Condition="'$(VS_PATH)' == ''">$(VINTAGE_STORY)</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('$(LOCALAPPDATA)\Vintagestory\VintagestoryAPI.dll')">$(LOCALAPPDATA)\Vintagestory</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('C:\Program Files\Vintagestory\VintagestoryAPI.dll')">C:\Program Files\Vintagestory</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('D:\Vintagestory\VintagestoryAPI.dll')">D:\Vintagestory</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('H:\Vintagestory\VintagestoryAPI.dll')">H:\Vintagestory</VS_PATH>
  </PropertyGroup>

  <!-- Fail loudly rather than build against a path that does not exist. -->
  <Target Name="CheckVsPath" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VS_PATH)\VintagestoryAPI.dll')"
           Text="Could not find VintagestoryAPI.dll under VS_PATH='$(VS_PATH)'. Set the VINTAGE_STORY environment variable or build with -p:VS_PATH=&quot;C:\Path\To\Vintagestory&quot;." />
  </Target>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VS_PATH)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VS_PATH)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Assemble a loadable mod folder and zip it ────────────────────────
       Staging into build/ keeps the zip separate from the repo-root mod folder. -->
  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <ModStageDir>$(MSBuildProjectDirectory)\build\lionfoxregentint</ModStageDir>
      <ModZipPath>$(MSBuildProjectDirectory)\build\lionfoxregentint_$(Version).zip</ModZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(ModStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModStageDir)" />
    <Copy SourceFiles="modinfo.json" DestinationFolder="$(ModStageDir)" />
    <Delete Files="$(ModZipPath)" />
    <ZipDirectory SourceDirectory="$(ModStageDir)" DestinationFile="$(ModZipPath)" />
    <Message Importance="high" Text="Packaged mod -> $(ModZipPath)" />
  </Target>

  <!-- The output folder keeps only this version's DLL: an older one beside it (lionfox_RegenTint.dll from before the names
       carried the version, or lionfox_RegenTint-<older>.dll) would be a second DLL with mod systems in a loadable mod folder. -->
  <Target Name="RemoveOlderModDll" AfterTargets="Build">
    <ItemGroup>
      <OlderModDll Include="$(OutDir)lionfox_RegenTint.dll;$(OutDir)lionfox_RegenTint.deps.json;$(OutDir)lionfox_RegenTint.pdb;$(OutDir)lionfox_RegenTint-*.dll;$(OutDir)lionfox_RegenTint-*.deps.json;$(OutDir)lionfox_RegenTint-*.pdb"
                   Exclude="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).deps.json;$(OutDir)$(TargetName).pdb" />
    </ItemGroup>
    <Delete Files="@(OlderModDll)" />
  </Target>

</Project>
